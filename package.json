{
  "name": "mcp-jena",
  "version": "1.0.0",
  "description": "Model Context Protocol server for Apache Jena SPARQL queries",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "ts-node --esm src/index.ts",
    "dev:transpile": "ts-node --transpile-only --esm src/index.ts",
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.ts"
  },
  "keywords": [
    "mcp",
    "jena",
    "sparql",
    "semantic-web",
    "rdf"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@types/node": "^20.11.0",
    "axios": "^1.6.8",
    "dotenv": "^16.4.5",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.2"
  }
}
